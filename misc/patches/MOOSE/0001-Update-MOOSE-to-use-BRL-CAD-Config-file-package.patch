-# We need BRL-CAD
-FIND_PACKAGE(BRLCAD REQUIRED)
+# We need BRL-CAD.  Try the modern Config-file package first (available
+# since BRL-CAD 7.40+); fall back to the legacy Module-mode FindBRLCAD
+# shipped with older installs.  The Config-file package provides
+# namespaced imported targets (BRLCAD::rt, BRLCAD::rt-static, etc.)
+# with full transitive dependency information, so downstream link rules
+# are greatly simplified when it is available.
+FIND_PACKAGE(BRLCAD CONFIG QUIET)
+IF(BRLCAD_FOUND)
+    MESSAGE(STATUS "Found BRL-CAD ${BRLCAD_VERSION} (Config mode) at ${BRLCAD_LIB_DIR}/..")
+    SET(BRLCAD_VERSION_FOUND TRUE)
+    # Populate version components from the Config-supplied version string if
+    # not already set by the config file (they should be).
+    IF(NOT BRLCAD_VERSION_MAJOR)
+        STRING(REGEX REPLACE "([0-9]+)\\.[0-9]+\\.[0-9]+" "\\1" BRLCAD_VERSION_MAJOR "${BRLCAD_VERSION}")
+        STRING(REGEX REPLACE "[0-9]+\\.([0-9]+)\\.[0-9]+" "\\1" BRLCAD_VERSION_MINOR "${BRLCAD_VERSION}")
+        STRING(REGEX REPLACE "[0-9]+\\.[0-9]+\\.([0-9]+)" "\\1" BRLCAD_VERSION_PATCH "${BRLCAD_VERSION}")
+    ENDIF()
+ELSE()
+    # Legacy path: use the Module-mode FindBRLCAD.cmake bundled with MOOSE.
+    FIND_PACKAGE(BRLCAD REQUIRED)
+ENDIF()
 
 IF(BRLCAD_VERSION_FOUND)
