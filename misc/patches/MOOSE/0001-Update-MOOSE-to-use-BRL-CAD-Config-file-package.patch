+# ---------------------------------------------------------------------------
+# Static-vs-shared selection
+#
+# With BRL-CAD 7.40+ Config-file package the imported targets already carry
+# full transitive dependency information, so we just need to pick the right
+# target variant.  With the legacy Module-mode FindBRLCAD.cmake we keep the
+# traditional explicit variable list.
+# ---------------------------------------------------------------------------
+
 OPTION(BRLCAD_STATIC_LINK "Link the BRL-CAD core libraries statically" ON)
 
+IF(TARGET BRLCAD::rt)
+    # -----------------------------------------------------------------------
+    # Modern path: BRLCADConfig.cmake (Config-file package) was found.
+    # BRLCAD::rt-static (and siblings) carry all transitive dependencies
+    # via INTERFACE_LINK_LIBRARIES, so the explicit variable lists below are
+    # not needed.
+    # -----------------------------------------------------------------------
+    IF(BRLCAD_STATIC_LINK AND TARGET BRLCAD::rt-static)
+        SET(_brlcad_rt    BRLCAD::rt-static)
+        SET(_brlcad_wdb   BRLCAD::wdb-static)
+        SET(_brlcad_ged   BRLCAD::ged-static)
+    ELSE()
+        SET(_brlcad_rt    BRLCAD::rt)
+        SET(_brlcad_wdb   BRLCAD::wdb)
+        SET(_brlcad_ged   BRLCAD::ged)
+    ENDIF()
+    SET(_brlcad_use_imported_targets TRUE)
+ELSE()
+    # -----------------------------------------------------------------------
+    # Legacy path: only Module-mode FindBRLCAD.cmake results are available.
+    # Keep the original explicit variable lists.
+    # -----------------------------------------------------------------------
+    SET(_brlcad_use_imported_targets FALSE)
+ENDIF()
+
 # Module: Database
 SET(DatabaseSources "")
 ADD_SUBDIRECTORY(Database)
