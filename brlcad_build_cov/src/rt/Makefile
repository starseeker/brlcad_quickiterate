	cd /home/runner/work/brlcad_quickiterate/brlcad_quickiterate/brlcad_build_cov && $(MAKE) $(MAKESILENT) -f src/rt/CMakeFiles/rtsurf.dir/build.make src/rt/CMakeFiles/rtsurf.dir/rtsurf_hits.cpp.i
.PHONY : rtsurf_hits.cpp.i

rtsurf_hits.s: rtsurf_hits.cpp.s
.PHONY : rtsurf_hits.s

# target to generate assembly for a file
rtsurf_hits.cpp.s:
	cd /home/runner/work/brlcad_quickiterate/brlcad_quickiterate/brlcad_build_cov && $(MAKE) $(MAKESILENT) -f src/rt/CMakeFiles/rtsurf.dir/build.make src/rt/CMakeFiles/rtsurf.dir/rtsurf_hits.cpp.s
.PHONY : rtsurf_hits.cpp.s

