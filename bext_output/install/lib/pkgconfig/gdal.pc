CONFIG_VERSION=3.12.1dev
CONFIG_INST_PREFIX=/home/cyapp/brlcad_quickiterate/bext_output/install
CONFIG_INST_LIBS=-L/home/cyapp/brlcad_quickiterate/bext_output/install/lib -lgdal
CONFIG_INST_CFLAGS=-I/home/cyapp/brlcad_quickiterate/bext_output/install/include/gdal
CONFIG_INST_DATA=/home/cyapp/brlcad_quickiterate/bext_output/install/share/gdal
prefix=${CONFIG_INST_PREFIX}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include/gdal
datadir=${CONFIG_INST_DATA}

Name: libgdal
Description: Geospatial Data Abstraction Library
Version: ${CONFIG_VERSION}
Libs: ${CONFIG_INST_LIBS}
Libs.private: -ldl -L/home/cyapp/brlcad_quickiterate/bext_output/install/lib -ltiff -lpng_brl -lsqlite3 -lproj -lz_brl -lstdc++ -lm
Cflags: ${CONFIG_INST_CFLAGS}
