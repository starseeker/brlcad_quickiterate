 and the entire }{\rtlch \ltrch\cs15\dbch\af9\dbch\af5\loch\f5\loch
RT_DIR_PHONY_ADDR}{\loch
 pathway. }
\par \pard\plain \s20\sl276\slmult1\sb0\sa140{\listtext\pard\plain \dbch\af6\dbch\af6\loch\f6 \u8226\'95\tab}\ilvl0\ls3 \li0\ri0\lin0\rin0\fi-283\ql\tx707\li707\ri0\lin707\rin0\fi-283\sb0\sa0\ltrpar{\rtlch \ltrch\cs16\ab\b\loch
Layer C}{\loch
 is mostly file moves + renames, validated by the existing build of }{\rtlch \ltrch\cs15\dbch\af9\dbch\af5\loch\f5\loch
libqtcad}{\loch
, }{\rtlch \ltrch\cs15\dbch\af9\dbch\af5\loch\f5\loch
dm-qtgl}{\loch
