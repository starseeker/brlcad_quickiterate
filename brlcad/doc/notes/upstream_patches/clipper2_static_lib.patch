From: BRL-CAD developers <devs@brlcad.org>
Subject: [PATCH] Add CLIPPER2_BUILD_STATIC_LIBS option to produce static archives alongside the primary libraries

Consumers that link their own code statically (e.g. BRL-CAD's static
library targets, or any framework that avoids runtime shared-library
dependencies) need static Clipper2 archives so they can link without
carrying libClipper2.so / libClipper2Z.so as runtime dependencies.

Clipper2 already sets CMAKE_POSITION_INDEPENDENT_CODE=ON globally, so
the object files produced for the shared libraries are already PIC-clean
and can be archived without rebuilding.  This patch adds an opt-in option
CLIPPER2_BUILD_STATIC_LIBS that:

 - Builds a Clipper2_static STATIC target from the same sources as the
   Clipper2 shared target when CLIPPER2_USINGZ is not "ONLY".
 - Builds a Clipper2Z_static STATIC target from the same sources as the
   Clipper2Z shared target when CLIPPER2_USINGZ is not "OFF".
 - Sets OUTPUT_NAME Clipper2 / Clipper2Z so the archives are named
   libClipper2.a / libClipper2Z.a on disk, avoiding confusingly-named
   libClipper2_static.a files.
 - Sets EXPORT_NAME Clipper2-static / Clipper2Z-static so the installed
   CMake targets are Clipper2::Clipper2-static and Clipper2::Clipper2Z-static,
   following the conventional -static suffix naming used by other BRL-CAD
   bundled deps (e.g. manifold::manifold-static).
 - Propagates the same PUBLIC compile definitions
   (CLIPPER2_MAX_DECIMAL_PRECISION, CLIPPER2_HI_PRECISION, and for the Z
   variant USINGZ) and include directories as the corresponding shared
   target.
 - Adds the static targets to the Clipper2-targets export set so that
   Clipper2Config.cmake exposes them to consumers automatically.

Default is OFF so no existing workflow is changed.  The option is
meaningful only when BUILD_SHARED_LIBS=ON; when building statically the
primary Clipper2/Clipper2Z targets are already archives.

A consumer that does:

  target_link_libraries(myapp PRIVATE Clipper2::Clipper2-static)

gets the full static Clipper2 archive linked in without needing to carry
libClipper2.so at runtime.

Applies to: BRL-CAD/Clipper2, main branch (CPP/CMakeLists.txt)
--- a/CPP/CMakeLists.txt
+++ b/CPP/CMakeLists.txt
@@ -19,6 +19,7 @@ set(CMAKE_CXX_EXTENSIONS OFF)
 set_property(GLOBAL PROPERTY USE_FOLDERS ON)
 
 # CLIPPER2_HI_PRECISION: See GetIntersectPoint() in clipper.core.h 
 option(CLIPPER2_HI_PRECISION "Caution: enabling this will compromise performance" OFF)
 
 option(CLIPPER2_UTILS "Build utilities" ON)
 option(CLIPPER2_EXAMPLES "Build examples" ON)
 option(CLIPPER2_TESTS "Build tests" ON)
 option(USE_EXTERNAL_GTEST "Use system-wide installed GoogleTest" OFF)
 option(USE_EXTERNAL_GBENCHMARK "Use the googlebenchmark" OFF)
 option(BUILD_SHARED_LIBS "Build shared libs" OFF)
+option(CLIPPER2_BUILD_STATIC_LIBS "Also build static library archives (Clipper2-static / Clipper2Z-static) alongside the primary libraries" OFF)
 set(CLIPPER2_USINGZ "ON" CACHE STRING "Build Clipper2Z, either \"ON\" or \"OFF\" or \"ONLY\"")
 
@@ -100,6 +101,59 @@ set_target_properties(${CLIPPER2_LIBS} PROPERTIES FOLDER Libraries
                                          PUBLIC_HEADER "${CLIPPER2_INC}"
 )
 
+# -----------------------------------------------------------------------
+# Optional static library targets (meaningful when BUILD_SHARED_LIBS=ON)
+# -----------------------------------------------------------------------
+if(CLIPPER2_BUILD_STATIC_LIBS)
+  set(CLIPPER2_STATIC_LIBS "")
+
+  if (NOT (CLIPPER2_USINGZ STREQUAL "ONLY"))
+    list(APPEND CLIPPER2_STATIC_LIBS Clipper2_static)
+    add_library(Clipper2_static STATIC ${CLIPPER2_INC} ${CLIPPER2_SRC})
+
+    set_target_properties(Clipper2_static PROPERTIES
+      OUTPUT_NAME  Clipper2
+      EXPORT_NAME  Clipper2-static
+    )
+
+    target_compile_definitions(Clipper2_static PUBLIC
+      CLIPPER2_MAX_DECIMAL_PRECISION=${CLIPPER2_MAX_DECIMAL_PRECISION}
+      $<$<BOOL:${CLIPPER2_HI_PRECISION}>:CLIPPER2_HI_PRECISION>
+    )
+
+    target_include_directories(Clipper2_static PUBLIC
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Clipper2Lib/include>
+      $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+    )
+
+    if (NOT MSVC)
+      target_link_libraries(Clipper2_static PUBLIC m)
+    endif()
+  endif()
+
+  if (NOT (CLIPPER2_USINGZ STREQUAL "OFF"))
+    list(APPEND CLIPPER2_STATIC_LIBS Clipper2Z_static)
+    add_library(Clipper2Z_static STATIC ${CLIPPER2_INC} ${CLIPPER2_SRC})
+
+    set_target_properties(Clipper2Z_static PROPERTIES
+      OUTPUT_NAME  Clipper2Z
+      EXPORT_NAME  Clipper2Z-static
+    )
+
+    target_compile_definitions(Clipper2Z_static PUBLIC
+      USINGZ
+      CLIPPER2_MAX_DECIMAL_PRECISION=${CLIPPER2_MAX_DECIMAL_PRECISION}
+      $<$<BOOL:${CLIPPER2_HI_PRECISION}>:CLIPPER2_HI_PRECISION>
+    )
+
+    target_include_directories(Clipper2Z_static PUBLIC
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Clipper2Lib/include>
+      $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+    )
+
+    if (NOT MSVC)
+      target_link_libraries(Clipper2Z_static PUBLIC m)
+    endif()
+  endif()
+
+  install(TARGETS ${CLIPPER2_STATIC_LIBS} EXPORT Clipper2-targets
+    ARCHIVE  DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+  )
+endif()
+# -----------------------------------------------------------------------
+
 if(CLIPPER2_UTILS OR CLIPPER2_TESTS OR CLIPPER2_EXAMPLES)
