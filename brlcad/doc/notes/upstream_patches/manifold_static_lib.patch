From: BRL-CAD developers <devs@brlcad.org>
Subject: [PATCH] Add MANIFOLD_BUILD_STATIC_LIBS option to produce a self-contained static archive alongside the shared library

Consumers that link their own code statically (e.g. BRL-CAD's static
library targets, MOOSE, or other scientific computing frameworks) need a
static manifold archive so they do not have to carry libmanifold.so as a
runtime dependency.

manifold already builds with CMAKE_POSITION_INDEPENDENT_CODE=ON
unconditionally, so the object files are suitable for inclusion in a
static archive without rebuilding.  This patch adds an opt-in option
MANIFOLD_BUILD_STATIC_LIBS that:

 - Builds a second target, manifold_static, from the same source list
   using add_library(... STATIC ...).
 - Sets EXPORT_NAME manifold-static so the installed cmake target is
   manifold::manifold-static, following the conventional -static suffix
   naming used by other BRL-CAD bundled deps (e.g. mmesh::mmesh-static).
 - Adds the static target to the manifoldTargets export set so that
   manifoldConfig.cmake exposes it to consumers automatically.
 - Reuses the OPTIONS variable already set by the shared-target section
   rather than duplicating the list.
 - Self-contained Clipper2 absorption: when MANIFOLD_USE_BUILTIN_CLIPPER2
   is ON, manifoldDeps.cmake builds Clipper2 as a static library via
   FetchContent (BUILD_SHARED_LIBS is forced OFF before the fetch).  The
   static manifold target absorbs those object files directly via the
   $<TARGET_OBJECTS:Clipper2> generator expression so that libmanifold.a
   has no runtime dependency on any Clipper2 library.  When an external
   (shared) Clipper2 is used instead, Clipper2::Clipper2 is recorded as a
   PUBLIC link dependency so consumers are aware they need to provide it.

Default is OFF so no existing workflow is changed.

Applies to: elalish/manifold, tag v3.2.1
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,6 +50,7 @@ option(BUILD_SHARED_LIBS "Build shared library" ON)
 # Set some option values in the CMake cache
 set(MANIFOLD_FLAGS "" CACHE STRING "Manifold compiler flags")
+option(MANIFOLD_BUILD_STATIC_LIBS "Also build a static library (manifold-static) alongside the shared library" OFF)
 
 # Development options
 option(TRACY_ENABLE "Use tracy profiling" OFF)

--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -86,6 +86,50 @@ target_include_directories(
 
 exportlib(manifold)
 
+# -----------------------------------------------------------------------
+# Optional static library target
+# -----------------------------------------------------------------------
+if(MANIFOLD_BUILD_STATIC_LIBS)
+  # When the builtin Clipper2 is active, manifoldDeps.cmake already built it
+  # as a STATIC library (it forces BUILD_SHARED_LIBS=OFF before FetchContent).
+  # Absorb those objects directly into our archive so libmanifold.a is
+  # self-contained.  With an external (shared) Clipper2 we fall back to
+  # recording it as a PUBLIC link dependency instead.
+  set(_clipper2_objects "")
+  if(MANIFOLD_CROSS_SECTION AND MANIFOLD_USE_BUILTIN_CLIPPER2)
+    set(_clipper2_objects $<TARGET_OBJECTS:Clipper2>)
+  endif()
+
+  add_library(manifold_static STATIC
+    ${MANIFOLD_SRCS} ${MANIFOLD_PRIVATE_HDRS} ${_clipper2_objects}
+  )
+  unset(_clipper2_objects)
+
+  set_target_properties(manifold_static PROPERTIES
+    OUTPUT_NAME  manifold
+    EXPORT_NAME  manifold-static
+  )
+
+  target_compile_features(manifold_static PUBLIC cxx_std_17)
+  target_compile_options(manifold_static PRIVATE ${MANIFOLD_FLAGS})
+
+  # Reuse the OPTIONS list already set above for the shared target.
+  foreach(OPT IN LISTS OPTIONS)
+    if(${${OPT}})
+      target_compile_definitions(manifold_static PUBLIC ${OPT})
+    endif()
+  endforeach()
+  if(MANIFOLD_PAR)
+    target_compile_definitions(manifold_static PUBLIC MANIFOLD_PAR=1)
+  else()
+    target_compile_definitions(manifold_static PUBLIC MANIFOLD_PAR=-1)
+  endif()
+
+  target_include_directories(manifold_static
+    PUBLIC
+      $<INSTALL_INTERFACE:include>
+      $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
+      $<BUILD_INTERFACE:${PROJECT_BINARY_DIR}/include>
+    PRIVATE
+      ${MANIFOLD_INCLUDE_DIRS}
+  )
+
+  target_link_libraries(manifold_static
+    PUBLIC
+      $<$<BOOL:${TRACY_ENABLE}>:TracyClient>
+      # External Clipper2 only: builtin objects are already absorbed above.
+      $<$<AND:$<BOOL:${MANIFOLD_CROSS_SECTION}>,$<NOT:$<BOOL:${MANIFOLD_USE_BUILTIN_CLIPPER2}>>>:Clipper2::Clipper2>
+    PRIVATE
+      $<$<BOOL:${MANIFOLD_PAR}>:TBB::tbb>
+      $<$<BOOL:${MANIFOLD_EXPORT}>:assimp::assimp>
+  )
+
+  install(TARGETS manifold_static EXPORT manifoldTargets
+    ARCHIVE  DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+  )
+endif()
+# -----------------------------------------------------------------------
+
 install(TARGETS manifold EXPORT manifoldTargets
