	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 k-g
.PHONY : k-g

# fast build rule for target.
k-g/fast:
	$(MAKE) $(MAKESILENT) -f src/conv/k-g/CMakeFiles/k-g.dir/build.make src/conv/k-g/CMakeFiles/k-g.dir/build
.PHONY : k-g/fast

