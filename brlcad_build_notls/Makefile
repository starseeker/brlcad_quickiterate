kman.g: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 kman.g
.PHONY : kman.g

# fast build rule for target.
kman.g/fast:
	$(MAKE) $(MAKESILENT) -f db/CMakeFiles/kman.g.dir/build.make db/CMakeFiles/kman.g.dir/build
.PHONY : kman.g/fast

