# target to generate assembly for a file
splitditc.c.s:
	cd /home/runner/work/brlcad_quickiterate/brlcad_quickiterate/brlcad_build_notls && $(MAKE) $(MAKESILENT) -f src/libfft/CMakeFiles/fftc.dir/build.make src/libfft/CMakeFiles/fftc.dir/splitditc.c.s
.PHONY : splitditc.c.s

